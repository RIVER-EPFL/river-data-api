FROM rust:1.95
RUN cargo install bacon
WORKDIR /app
# Only copy manifests for initial dependency fetch — source is volume-mounted at runtime
COPY Cargo.toml Cargo.lock ./
COPY migration/Cargo.toml migration/Cargo.toml
# Create stub source files so cargo can resolve the workspace
RUN mkdir -p src && echo "fn main() {}" > src/main.rs && echo "" > src/lib.rs \
    && mkdir -p migration/src && echo "fn main() {}" > migration/src/main.rs && echo "" > migration/src/lib.rs
# Pre-fetch dependencies (|| true: local [patch] deps may not exist at build time)
RUN cargo fetch || true
ENTRYPOINT ["bacon", "--headless", "run"]
