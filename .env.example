# Database (docker-compose maps these to DB_* for the app)
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=changeme
#POSTGRES_DB=postgres
#POSTGRES_EXTERNAL_PORT=5443
#TIMESCALEDB_VERSION=2.23.0-pg18

# Vaisala API

# Sync settings (seconds)

# API settings
API_HOST=0.0.0.0
API_PORT=3000
API_EXTERNAL_PORT=3005

# Rate limiting (set to true to disable all rate limits for development)
#DISABLE_RATE_LIMITING=true

# Application
DEPLOYMENT=dev
# RUST_LOG is set in docker-compose.yaml with sqlx/sea_orm suppressed

# Traefik
TRAEFIK_HTTP_PORT=88
TRAEFIK_DASHBOARD_PORT=8088

# Analytical tool runner (OpenCPU); unset leaves /api/tools answering 503
TOOLS_RUNNER_URL=http://localhost:8006/ocpu
TOOLS_RUNNER_TIMEOUT_SECONDS=60
