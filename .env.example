# Database (docker-compose maps these to DB_* for the app)
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=changeme
#POSTGRES_DB=postgres
#POSTGRES_EXTERNAL_PORT=5443
#TIMESCALEDB_VERSION=2.23.0-pg18

# Vaisala API

# Sync settings (seconds)

# API settings
API_HOST=0.0.0.0
API_PORT=3000
API_EXTERNAL_PORT=3005

# Rate limiting (set to true to disable all rate limits for development)
#DISABLE_RATE_LIMITING=true

# Application
DEPLOYMENT=dev
# RUST_LOG is set in docker-compose.yaml with sqlx/sea_orm suppressed

# Traefik
TRAEFIK_HTTP_PORT=88
TRAEFIK_DASHBOARD_PORT=8088

# Analytical tool runner (OpenCPU); unset leaves /api/tools answering 503
TOOLS_RUNNER_URL=http://localhost:8006/ocpu
TOOLS_RUNNER_TIMEOUT_SECONDS=60

# MeteoSwiss Open Government Data, the barometric pressure the oxygen-saturation procedure needs.
# A site with no subscription takes nothing, so the defaults are safe to leave alone.
METEOSWISS_BASE_URL=https://data.geo.admin.ch/ch.meteoschweiz.ogd-smn
METEOSWISS_LATEST_URL=https://data.geo.admin.ch/ch.meteoschweiz.messwerte-aktuell/VQHA80.csv
METEOSWISS_STAC_URL=https://data.geo.admin.ch/api/stac/v1/collections/ch.meteoschweiz.ogd-smn/items
METEOSWISS_INTERVAL_SECONDS=600
METEOSWISS_RECENT_INTERVAL_SECONDS=86400
METEOSWISS_TIMEOUT_SECONDS=60
