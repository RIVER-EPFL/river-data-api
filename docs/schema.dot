    "site_parameters" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79"><TR><TD BGCOLOR="#dbe7f3" COLSPAN="2"><B>site_parameters</B></TD></TR><TR><TD PORT="id__l" ALIGN="LEFT">id</TD><TD PORT="id__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR><TR><TD PORT="site_id__l" ALIGN="LEFT">site_id</TD><TD PORT="site_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="parameter_id__l" ALIGN="LEFT">parameter_id</TD><TD PORT="parameter_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="instrument_sensor_id__l" ALIGN="LEFT">instrument_sensor_id</TD><TD PORT="instrument_sensor_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR></TABLE>>];
