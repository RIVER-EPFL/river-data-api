digraph schema {
  graph [rankdir=LR, splines=spline, nodesep=0.4, ranksep=1.4, bgcolor="#ffffff", fontname="Helvetica", labelloc=t];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [color="#8a8a8a", penwidth=0.9, arrowsize=0.7];
    "projects" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79"><TR><TD BGCOLOR="#dbe7f3" COLSPAN="2"><B>projects</B></TD></TR><TR><TD PORT="id__l" ALIGN="LEFT">id</TD><TD PORT="id__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR></TABLE>>];
    "subprojects" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79"><TR><TD BGCOLOR="#dbe7f3" COLSPAN="2"><B>subprojects</B></TD></TR><TR><TD PORT="id__l" ALIGN="LEFT">id</TD><TD PORT="id__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR><TR><TD PORT="project_id__l" ALIGN="LEFT">project_id</TD><TD PORT="project_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR></TABLE>>];
    "sites" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79"><TR><TD BGCOLOR="#dbe7f3" COLSPAN="2"><B>sites</B></TD></TR><TR><TD PORT="id__l" ALIGN="LEFT">id</TD><TD PORT="id__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR><TR><TD PORT="project_id__l" ALIGN="LEFT">project_id</TD><TD PORT="project_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="subproject_id__l" ALIGN="LEFT">subproject_id</TD><TD PORT="subproject_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR></TABLE>>];
    "site_parameters" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79"><TR><TD BGCOLOR="#dbe7f3" COLSPAN="2"><B>site_parameters</B></TD></TR><TR><TD PORT="id__l" ALIGN="LEFT">id</TD><TD PORT="id__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR><TR><TD PORT="site_id__l" ALIGN="LEFT">site_id</TD><TD PORT="site_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="parameter_id__l" ALIGN="LEFT">parameter_id</TD><TD PORT="parameter_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="derived_definition_id__l" ALIGN="LEFT">derived_definition_id</TD><TD PORT="derived_definition_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR></TABLE>>];
    "parameters" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79"><TR><TD BGCOLOR="#dbe7f3" COLSPAN="2"><B>parameters</B></TD></TR><TR><TD PORT="id__l" ALIGN="LEFT">id</TD><TD PORT="id__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR></TABLE>>];
    "data_streams" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79"><TR><TD BGCOLOR="#dbe7f3" COLSPAN="2"><B>data_streams</B></TD></TR><TR><TD PORT="id__l" ALIGN="LEFT">id</TD><TD PORT="id__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR><TR><TD PORT="site_parameter_id__l" ALIGN="LEFT">site_parameter_id</TD><TD PORT="site_parameter_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="sensor_id__l" ALIGN="LEFT">sensor_id</TD><TD PORT="sensor_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="pairing_plan_id__l" ALIGN="LEFT">pairing_plan_id</TD><TD PORT="pairing_plan_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR></TABLE>>];
    "readings" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79"><TR><TD BGCOLOR="#dbe7f3" COLSPAN="2"><B>readings</B></TD></TR><TR><TD PORT="stream_id__l" ALIGN="LEFT">stream_id</TD><TD PORT="stream_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK,FK</FONT></TD></TR><TR><TD PORT="time__l" ALIGN="LEFT">time</TD><TD PORT="time__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR><TR><TD PORT="replicate_index__l" ALIGN="LEFT">replicate_index</TD><TD PORT="replicate_index__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR><TR><TD PORT="site_id__l" ALIGN="LEFT">site_id</TD><TD PORT="site_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="parameter_id__l" ALIGN="LEFT">parameter_id</TD><TD PORT="parameter_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="sensor_id__l" ALIGN="LEFT">sensor_id</TD><TD PORT="sensor_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="calibration_id__l" ALIGN="LEFT">calibration_id</TD><TD PORT="calibration_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="deployment_id__l" ALIGN="LEFT">deployment_id</TD><TD PORT="deployment_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="sample_id__l" ALIGN="LEFT">sample_id</TD><TD PORT="sample_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="standard_curve_id__l" ALIGN="LEFT">standard_curve_id</TD><TD PORT="standard_curve_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="collection_event_id__l" ALIGN="LEFT">collection_event_id</TD><TD PORT="collection_event_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR></TABLE>>];
    "samples" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79"><TR><TD BGCOLOR="#dbe7f3" COLSPAN="2"><B>samples</B></TD></TR><TR><TD PORT="id__l" ALIGN="LEFT">id</TD><TD PORT="id__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR><TR><TD PORT="site_id__l" ALIGN="LEFT">site_id</TD><TD PORT="site_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="parameter_id__l" ALIGN="LEFT">parameter_id</TD><TD PORT="parameter_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR></TABLE>>];
    "collection_events" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79"><TR><TD BGCOLOR="#dbe7f3" COLSPAN="2"><B>collection_events</B></TD></TR><TR><TD PORT="id__l" ALIGN="LEFT">id</TD><TD PORT="id__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR><TR><TD PORT="site_id__l" ALIGN="LEFT">site_id</TD><TD PORT="site_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR></TABLE>>];
    "sensors" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79"><TR><TD BGCOLOR="#dbe7f3" COLSPAN="2"><B>sensors</B></TD></TR><TR><TD PORT="id__l" ALIGN="LEFT">id</TD><TD PORT="id__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR></TABLE>>];
    "sensor_deployments" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79"><TR><TD BGCOLOR="#dbe7f3" COLSPAN="2"><B>sensor_deployments</B></TD></TR><TR><TD PORT="id__l" ALIGN="LEFT">id</TD><TD PORT="id__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR><TR><TD PORT="sensor_id__l" ALIGN="LEFT">sensor_id</TD><TD PORT="sensor_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="site_id__l" ALIGN="LEFT">site_id</TD><TD PORT="site_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="parameter_id__l" ALIGN="LEFT">parameter_id</TD><TD PORT="parameter_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR></TABLE>>];
    "sensor_calibrations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79"><TR><TD BGCOLOR="#dbe7f3" COLSPAN="2"><B>sensor_calibrations</B></TD></TR><TR><TD PORT="id__l" ALIGN="LEFT">id</TD><TD PORT="id__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR><TR><TD PORT="sensor_id__l" ALIGN="LEFT">sensor_id</TD><TD PORT="sensor_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR><TR><TD PORT="parameter_id__l" ALIGN="LEFT">parameter_id</TD><TD PORT="parameter_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR></TABLE>>];
    "standard_curves" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79"><TR><TD BGCOLOR="#dbe7f3" COLSPAN="2"><B>standard_curves</B></TD></TR><TR><TD PORT="id__l" ALIGN="LEFT">id</TD><TD PORT="id__r" ALIGN="RIGHT"><FONT COLOR="#777777">PK</FONT></TD></TR><TR><TD PORT="sensor_id__l" ALIGN="LEFT">sensor_id</TD><TD PORT="sensor_id__r" ALIGN="RIGHT"><FONT COLOR="#777777">FK</FONT></TD></TR></TABLE>>];
  "collection_events":"site_id__r":e -> "sites":"id__l":w [dir=both, arrowtail=crow, arrowhead=tee];
  "data_streams":"sensor_id__r":e -> "sensors":"id__l":w [dir=both, arrowtail=crow, arrowhead=teeodot];
  "data_streams":"site_parameter_id__r":e -> "site_parameters":"id__l":w [dir=both, arrowtail=crow, arrowhead=teeodot];
  "readings":"calibration_id__r":e -> "sensor_calibrations":"id__l":w [dir=both, arrowtail=crow, arrowhead=teeodot];
  "readings":"collection_event_id__r":e -> "collection_events":"id__l":w [dir=both, arrowtail=crow, arrowhead=teeodot];
  "readings":"deployment_id__r":e -> "sensor_deployments":"id__l":w [dir=both, arrowtail=crow, arrowhead=teeodot];
  "readings":"parameter_id__r":e -> "parameters":"id__l":w [dir=both, arrowtail=crow, arrowhead=teeodot];
  "readings":"sample_id__r":e -> "samples":"id__l":w [dir=both, arrowtail=crow, arrowhead=teeodot];
  "readings":"sensor_id__r":e -> "sensors":"id__l":w [dir=both, arrowtail=crow, arrowhead=teeodot];
  "readings":"site_id__r":e -> "sites":"id__l":w [dir=both, arrowtail=crow, arrowhead=teeodot];
  "readings":"standard_curve_id__r":e -> "standard_curves":"id__l":w [dir=both, arrowtail=crow, arrowhead=teeodot];
  "readings":"stream_id__r":e -> "data_streams":"id__l":w [dir=both, arrowtail=crow, arrowhead=tee];
  "samples":"parameter_id__r":e -> "parameters":"id__l":w [dir=both, arrowtail=crow, arrowhead=tee];
  "samples":"site_id__r":e -> "sites":"id__l":w [dir=both, arrowtail=crow, arrowhead=tee];
  "sensor_calibrations":"parameter_id__r":e -> "parameters":"id__l":w [dir=both, arrowtail=crow, arrowhead=teeodot];
  "sensor_calibrations":"sensor_id__r":e -> "sensors":"id__l":w [dir=both, arrowtail=crow, arrowhead=tee];
  "sensor_deployments":"parameter_id__r":e -> "parameters":"id__l":w [dir=both, arrowtail=crow, arrowhead=tee];
  "sensor_deployments":"sensor_id__r":e -> "sensors":"id__l":w [dir=both, arrowtail=crow, arrowhead=tee];
  "sensor_deployments":"site_id__r":e -> "sites":"id__l":w [dir=both, arrowtail=crow, arrowhead=tee];
  "site_parameters":"parameter_id__r":e -> "parameters":"id__l":w [dir=both, arrowtail=crow, arrowhead=tee];
  "site_parameters":"site_id__r":e -> "sites":"id__l":w [dir=both, arrowtail=crow, arrowhead=tee];
  "sites":"project_id__r":e -> "projects":"id__l":w [dir=both, arrowtail=crow, arrowhead=teeodot];
  "sites":"subproject_id__r":e -> "subprojects":"id__l":w [dir=both, arrowtail=crow, arrowhead=teeodot];
  "standard_curves":"sensor_id__r":e -> "sensors":"id__l":w [dir=both, arrowtail=crow, arrowhead=tee];
  "subprojects":"project_id__r":e -> "projects":"id__l":w [dir=both, arrowtail=crow, arrowhead=tee];
}
