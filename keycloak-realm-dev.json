{
  "realm": "river-data",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "riverdata-admin",
        "description": "River Data administrator with full access"
      },
      {
        "name": "riverdata-intern",
        "description": "River Data intern: read-only access"
      },
      {
        "name": "riverdata-river",
        "description": "River Data staff: write data and field metadata"
      },
      {
        "name": "riverdata-manager",
        "description": "River Data manager: manage sensors and the catalog"
      }
    ]
  },
  "clients": [
    {
      "clientId": "river-data-ui-local",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:*",
        "http://localhost:3005/*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "attributes": {}
    },
    {
      "clientId": "river-data-api-local",
      "enabled": true,
      "publicClient": false,
      "secret": "river-data-api-local-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "attributes": {}
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@local.dev",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "riverdata-admin"
      ]
    },
    {
      "username": "user",
      "enabled": true,
      "email": "user@local.dev",
      "firstName": "Regular",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "realmRoles": [
        "riverdata-river"
      ]
    },
    {
      "username": "intern1",
      "enabled": true,
      "emailVerified": true,
      "email": "intern1@local.dev",
      "firstName": "Test",
      "lastName": "Intern",
      "credentials": [{ "type": "password", "value": "intern1", "temporary": false }],
      "realmRoles": ["riverdata-intern"]
    },
    {
      "username": "river1",
      "enabled": true,
      "emailVerified": true,
      "email": "river1@local.dev",
      "firstName": "Test",
      "lastName": "River",
      "credentials": [{ "type": "password", "value": "river1", "temporary": false }],
      "realmRoles": ["riverdata-river"]
    },
    {
      "username": "manager1",
      "enabled": true,
      "emailVerified": true,
      "email": "manager1@local.dev",
      "firstName": "Test",
      "lastName": "Manager",
      "credentials": [{ "type": "password", "value": "manager1", "temporary": false }],
      "realmRoles": ["riverdata-manager"]
    },
    {
      "username": "norole",
      "enabled": true,
      "emailVerified": true,
      "email": "norole@local.dev",
      "firstName": "No",
      "lastName": "Role",
      "credentials": [{ "type": "password", "value": "norole", "temporary": false }],
      "realmRoles": []
    },
    {
      "username": "service-account-river-data-api",
      "enabled": true,
      "serviceAccountClientId": "river-data-api-local",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    }
  ]
}
